# Copy this file to .env and fill in your own Stripe TEST keys.
# Get them from https://dashboard.stripe.com/test/apikeys — use a SEPARATE
# restricted key set for mobilegame.lol, even though it's the same Stripe
# account (UNSAL LTD) as coffeebid.lol.
STRIPE_SECRET_KEY=sk_test_...
STRIPE_PUBLISHABLE_KEY=pk_test_...

# Get this by running `stripe listen --forward-to localhost:5183/webhook` (Stripe CLI)
# and copying the "whsec_..." value it prints. Needed so we can verify webhook
# calls really came from Stripe before we trust a payment as "paid".
STRIPE_WEBHOOK_SECRET=whsec_...

PORT=5183

# From your Render Postgres instance's "External Database URL" —
# use a NEW Postgres instance, separate from coffeebid's.
DATABASE_URL=postgresql://user:password@host/dbname
